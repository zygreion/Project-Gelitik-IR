# Konfigurasi lingkungan GELITIK frontend.
# Salin berkas ini menjadi `.env` lalu sesuaikan nilainya.

# Basis URL API backend IR (tanpa garis miring di akhir).
# Contoh: http://localhost:8000/api
VITE_API_BASE_URL=/api

# true  -> gunakan korpus demo lokal (default, untuk pengembangan UI)
# false -> panggil API backend IR yang sesungguhnya
VITE_USE_MOCK_DATA=true
